<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Ehsan Najafi | Personal Website</title>
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body {
    font-family: 'Segoe UI', Arial, sans-serif;
    background: #f5f5f5;
    color: #1a1a1a;
    overflow-x: hidden;
  }

  /* ===== HERO WITH ROTATING CAR ===== */
  .showcase {
    position: relative;
    height: 100vh;
    background: linear-gradient(135deg, #1a1a1a 0%, #2d2d2d 50%, #1a1a1a 100%);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }
  .showcase::before {
    content: '';
    position: absolute;
    width: 800px; height: 800px;
    background: radial-gradient(circle, rgba(0,102,177,0.25) 0%, transparent 60%);
    border-radius: 50%;
    top: 50%; left: 50%;
    transform: translate(-50%, -50%);
    animation: pulse 4s infinite ease-in-out;
  }
  @keyframes pulse {
    0%, 100% { transform: translate(-50%, -50%) scale(1); opacity: 0.6; }
    50% { transform: translate(-50%, -50%) scale(1.15); opacity: 1; }
  }

  .showcase-title {
    position: absolute;
    top: 60px;
    text-align: center;
    z-index: 3;
  }
  .showcase-title h1 {
    font-size: 38px;
    font-weight: 300;
    letter-spacing: 6px;
    color: #fff;
    margin-bottom: 12px;
  }
  .showcase-title h1 strong { font-weight: 700; color: #4da6ff; }
  .showcase-title p {
    font-size: 14px;
    letter-spacing: 4px;
    color: #4da6ff;
    text-transform: uppercase;
    font-weight: 300;
  }

  .car-wrapper {
    position: relative;
    width: 100%;
    max-width: 700px;
    perspective: 1200px;
    z-index: 2;
  }

  .car {
    position: relative;
    width: 100%;
    height: 280px;
    transform-style: preserve-3d;
    transition: transform 0.1s linear;
  }

  .car-body {
    position: absolute;
    bottom: 60px;
    left: 5%;
    width: 90%;
    height: 120px;
    background: linear-gradient(180deg, #0066b1 0%, #004a80 60%, #003355 100%);
    border-radius: 60px 80px 20px 20px;
    box-shadow:
      0 20px 60px rgba(0,102,177,0.5),
      inset 0 -10px 30px rgba(0,0,0,0.3),
      inset 0 10px 20px rgba(255,255,255,0.15);
  }
  .car-body::before {
    content: '';
    position: absolute;
    top: 15px;
    left: 20%;
    width: 60%;
    height: 40px;
    background: linear-gradient(180deg, #1a1a1a 0%, #333 100%);
    border-radius: 40px 40px 10px 10px;
    box-shadow: inset 0 5px 10px rgba(0,0,0,0.5);
  }
  .car-body::after {
    content: '';
    position: absolute;
    top: 30px;
    left: 22%;
    width: 26%;
    height: 22px;
    background: linear-gradient(135deg, #4da6ff, #0066b1);
    border-radius: 5px;
    box-shadow: 0 0 20px rgba(77,166,255,0.5);
  }

  .headlight {
    position: absolute;
    top: 40px;
    right: 8%;
    width: 40px;
    height: 18px;
    background: #fff;
    border-radius: 10px 30px 30px 10px;
    box-shadow: 0 0 30px 10px rgba(255,255,255,0.8), 0 0 60px 20px rgba(77,166,255,0.4);
    animation: flicker 2s infinite;
  }
  @keyframes flicker {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.85; }
  }

  .taillight {
    position: absolute;
    top: 45px;
    left: 5%;
    width: 25px;
    height: 14px;
    background: #ff3333;
    border-radius: 10px 5px 5px 10px;
    box-shadow: 0 0 20px 5px rgba(255,51,51,0.7);
  }

  .wheel {
    position: absolute;
    bottom: 30px;
    width: 75px;
    height: 75px;
    background: radial-gradient(circle, #444 0%, #1a1a1a 60%, #000 100%);
    border-radius: 50%;
    border: 5px solid #333;
    box-shadow: 0 5px 20px rgba(0,0,0,0.6), inset 0 0 20px rgba(0,0,0,0.8);
  }
  .wheel::before {
    content: '';
    position: absolute;
    top: 50%; left: 50%;
    transform: translate(-50%, -50%);
    width: 30px; height: 30px;
    background: radial-gradient(circle, #888, #333);
    border-radius: 50%;
  }
  .wheel::after {
    content: '';
    position: absolute;
    top: 50%; left: 50%;
    transform: translate(-50%, -50%);
    width: 60px; height: 4px;
    background: #555;
    border-radius: 2px;
    box-shadow: 0 -20px 0 #555, 0 20px 0 #555;
  }
  .wheel-front { right: 12%; }
  .wheel-back { left: 12%; }

  .showcase-hint {
    position: absolute;
    bottom: 50px;
    color: rgba(255,255,255,0.6);
    font-size: 13px;
    letter-spacing: 2px;
    animation: bounce 2s infinite;
  }
  @keyframes bounce {
    0%, 100% { transform: translateY(0); opacity: 0.6; }
    50% { transform: translateY(-10px); opacity: 1; }
  }

  .bmw-badge {
    position: absolute;
    top: -30px;
    left: 50%;
    transform: translateX(-50%);
    width: 60px;
    height: 60px;
    border-radius: 50%;
    background: conic-gradient(#0066b1 0deg 90deg, #fff 90deg 180deg, #0066b1 180deg 270deg, #fff 270deg 360deg);
    border: 4px solid #1a1a1a;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 13px;
    font-weight: bold;
    color: #000;
    box-shadow: 0 10px 30px rgba(0,0,0,0.5);
    z-index: 3;
  }

  /* ===== HEADER ===== */
  header {
    position: sticky;
    top: 0;
    z-index: 100;
    padding: 18px 40px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: rgba(255,255,255,0.95);
    backdrop-filter: blur(20px);
    border-bottom: 1px solid #e5e5e5;
  }
  .logo {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 18px;
    font-weight: 600;
    letter-spacing: 2px;
  }
  .logo-circle {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: linear-gradient(135deg, #0066b1, #4da6ff);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 14px;
    font-weight: bold;
    color: #fff;
  }
  nav a {
    color: #333;
    text-decoration: none;
    margin-left: 30px;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 1px;
    transition: color 0.3s;
    text-transform: uppercase;
  }
  nav a:hover { color: #0066b1; }

  /* ===== SECTIONS ===== */
  .section {
    max-width: 1000px;
    margin: 0 auto;
    padding: 90px 30px;
  }
  .section-title {
    font-size: 38px;
    font-weight: 300;
    margin-bottom: 12px;
    letter-spacing: 3px;
    text-align: center;
  }
  .section-title strong { font-weight: 700; color: #0066b1; }
  .section-subtitle {
    text-align: center;
    color: #777;
    font-size: 13px;
    letter-spacing: 3px;
    margin-bottom: 50px;
    text-transform: uppercase;
  }
  .section p {
    font-size: 16px;
    line-height: 2;
    color: #555;
    text-align: center;
    max-width: 750px;
    margin: 0 auto;
  }

  /* ===== SKILLS ===== */
  .skills-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 25px;
    margin-top: 40px;
  }
  .skill {
    background: #fff;
    border: 1px solid #e0e0e0;
    border-radius: 12px;
    padding: 30px 25px;
    width: 220px;
    text-align: center;
    transition: all 0.4s;
  }
  .skill:hover {
    transform: translateY(-6px);
    border-color: #0066b1;
    box-shadow: 0 15px 40px rgba(0,102,177,0.15);
  }
  .skill .icon {
    font-size: 38px;
    margin-bottom: 15px;
    display: block;
  }
  .skill h4 {
    font-size: 16px;
    font-weight: 600;
    color: #1a1a1a;
  }

  /* ===== PROJECTS ===== */
  .projects {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 30px;
    margin-top: 40px;
  }
  .project {
    background: #fff;
    width: 300px;
    border: 1px solid #e0e0e0;
    border-radius: 12px;
    overflow: hidden;
    transition: all 0.4s;
  }
  .project:hover {
    transform: translateY(-6px);
    box-shadow: 0 20px 50px rgba(0,0,0,0.12);
  }
  .project-image {
    height: 170px;
    background: linear-gradient(135deg, #0066b1, #4da6ff);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 60px;
  }
  .project-info { padding: 22px; }
  .project-info h4 {
    font-size: 18px;
    margin-bottom: 10px;
    color: #1a1a1a;
  }
  .project-info p {
    font-size: 14px;
    color: #777;
    line-height: 1.8;
    text-align: left;
  }

  /* ===== CONTACT ===== */
  .contact {
    background: #1a1a1a;
    padding: 90px 30px;
    color: #fff;
  }
  .contact .section-title { color: #fff; }
  .contact .section-title strong { color: #4da6ff; }
  .contact .section-subtitle { color: #888; }
  .contact-form {
    max-width: 550px;
    margin: 0 auto;
  }
  .form-group { margin-bottom: 22px; }
  .form-group label {
    display: block;
    margin-bottom: 8px;
    font-size: 12px;
    font-weight: 600;
    color: #ccc;
    letter-spacing: 1px;
    text-transform: uppercase;
  }
  .form-group input,
  .form-group textarea {
    width: 100%;
    padding: 16px 18px;
    background: #0a0a0a;
    border: 1px solid rgba(0,102,177,0.3);
    border-radius: 6px;
    color: #fff;
    font-family: inherit;
    font-size: 15px;
    transition: all 0.3s;
  }
  .form-group input:focus,
  .form-group textarea:focus {
    outline: none;
    border-color: #4da6ff;
    box-shadow: 0 0 0 3px rgba(77,166,255,0.15);
  }
  .form-group textarea { resize: vertical; min-height: 120px; }
  .submit-btn {
    width: 100%;
    padding: 18px;
    background: linear-gradient(135deg, #0066b1, #4da6ff);
    border: none;
    border-radius: 6px;
    color: #fff;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 2px;
    cursor: pointer;
    transition: all 0.3s;
    text-transform: uppercase;
  }
  .submit-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 30px rgba(77,166,255,0.4);
  }

  /* ===== FOOTER ===== */
  footer {
    background: #050505;
    color: #888;
    text-align: center;
    padding: 35px;
    font-size: 12px;
    letter-spacing: 1px;
  }

  @media (max-width: 600px) {
    header { flex-direction: column; gap: 15px; padding: 15px; }
    nav a { margin: 0 10px; font-size: 11px; }
    .showcase-title h1 { font-size: 24px; letter-spacing: 3px; }
    .section-title { font-size: 26px; }
    .section { padding: 60px 20px; }
  }
</style>
</head>
<body>

  <!-- ===== HEADER ===== -->
